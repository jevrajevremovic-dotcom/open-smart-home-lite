<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/title"
        style="@style/HomeWidgetTitle"
        android:text="@string/status_widget_label" />

    <TextView android:id="@+id/line1" style="@style/HomeWidgetLine" />
    <TextView android:id="@+id/line2" style="@style/HomeWidgetLine" />
    <TextView android:id="@+id/line3" style="@style/HomeWidgetLine" />
    <TextView android:id="@+id/line4" style="@style/HomeWidgetLine" />

    <TextView
        android:id="@+id/updated"
        style="@style/HomeWidgetSmall"
        android:layout_marginTop="4dp" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Devices on the local network (Shelly, WLED, Tasmota, Hue, ESPHome…)
  answer over plain HTTP only, and Android cannot scope cleartext to
  private addresses, so it is allowed. The app only talks to addresses
  the household added or the network announced. Only system CAs are
  trusted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
